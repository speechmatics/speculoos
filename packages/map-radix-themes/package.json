{
  "name": "@speculoos/map-radix-themes",
  "version": "0.0.1",
  "description": "A Speculoos component map for Radix Themes. Twelve components, not a renderer.",
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "vite --config dev/vite.config.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@radix-ui/themes": "^3.0.0",
    "@speculoos/react": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@speculoos/asyncapi": "workspace:*",
    "@speculoos/core": "workspace:*",
    "@speculoos/fixtures": "workspace:*",
    "@speculoos/loader": "workspace:*",
    "@speculoos/openapi": "workspace:*",
    "@speculoos/react": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
