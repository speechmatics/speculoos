  &quot;message&quot;: &quot;StartRecognition&quot;
}</code></pre></div></div><div class="rt-ScrollAreaViewportFocusRing"></div></div></div></div></div></div></div><div class="rt-Flex rt-r-ai-center rt-r-gap-3"><span data-accent-color="gray" style="flex:1" class="rt-Separator rt-r-orientation-horizontal rt-r-size-4"></span><span data-accent-color="gray" class="rt-Text rt-r-size-1 rt-r-weight-medium">or</span><span data-accent-color="gray" style="flex:1" class="rt-Separator rt-r-orientation-horizontal rt-r-size-4"></span></div><div class="rt-reset rt-BaseCard rt-Card rt-r-size-2 rt-variant-surface"><div class="rt-Text rt-r-size-3 rt-r-weight-bold rt-r-mb-2">AddAudio</div><span data-accent-color="gray" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">application/json</span><span data-accent-color="gray" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">&quot;AddAudio&quot;</span><dl data-kind="fields" class="rt-Text rt-DataListRoot rt-r-orientation-horizontal rt-r-size-2 rt-r-my-3"><div data-key="message" class="rt-DataListItem rt-r-ai-start"><dt style="--min-width:180px" class="rt-DataListLabel rt-r-min-w"><div class="rt-Box rt-r-pl-0"><div class="rt-Flex rt-r-fd-column rt-r-ai-start rt-r-gap-1"><span class="rt-Text rt-r-weight-bold"><code class="rt-reset rt-Code rt-variant-ghost">message</code></span><span data-accent-color="red" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">required</span></div></div></dt><dd class="rt-DataListValue"><div class="rt-Flex rt-r-fd-column rt-r-gap-1"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><code class="rt-reset rt-Code rt-variant-ghost">&quot;AddAudio&quot;</code></div></div></dd></div><div data-key="seq_no" class="rt-DataListItem rt-r-ai-start"><dt style="--min-width:180px" class="rt-DataListLabel rt-r-min-w"><div class="rt-Box rt-r-pl-0"><div class="rt-Flex rt-r-fd-column rt-r-ai-start rt-r-gap-1"><span class="rt-Text rt-r-weight-bold"><code class="rt-reset rt-Code rt-variant-ghost">seq_no</code></span></div></div></dt><dd class="rt-DataListValue">