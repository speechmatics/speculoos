exports[`snapshots > one message operation 1`] = `
"<div data-is-root-theme="true" data-accent-color="indigo" data-gray-color="slate" data-has-background="true" data-panel-background="translucent" data-radius="medium" data-scaling="100%" class="radix-themes"><section data-kind="operation" id="send-to-server" class="rt-Box rt-r-mt-7 rt-r-mb-5"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h2 class="rt-Heading rt-r-size-6">Messages the client sends.</h2></div><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><span data-accent-color="blue" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">client → server</span><code class="rt-reset rt-Code rt-variant-ghost">/v2/{language}</code></div></div><span data-accent-color="cyan" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">wss</span><section data-kind="parameters" class="rt-Box rt-r-mt-5 rt-r-mb-3"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h3 class="rt-Heading rt-r-size-5">Address parameters</h3></div></div><dl data-kind="parameters" class="rt-Text rt-DataListRoot rt-r-orientation-horizontal rt-r-size-2 rt-r-my-3"><div data-key="language" class="rt-DataListItem rt-r-ai-start"><dt style="--min-width:180px" class="rt-DataListLabel rt-r-min-w"><div class="rt-Box rt-r-pl-0"><div class="rt-Flex rt-r-fd-column rt-r-ai-start rt-r-gap-1"><span class="rt-Text rt-r-weight-bold"><code class="rt-reset rt-Code rt-variant-ghost">language</code></span><span data-accent-color="red" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">required</span></div></div></dt><dd class="rt-DataListValue"><div class="rt-Flex rt-r-fd-column rt-r-gap-1"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><code class="rt-reset rt-Code rt-variant-ghost">string</code></div><div data-md="">Language of the audio.</div></div></dd></div></dl></section><section data-kind="messages" class="rt-Box rt-r-mt-5 rt-r-mb-3"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h3 class="rt-Heading rt-r-size-5">Messages</h3></div></div><div data-kind="message" class="rt-Flex rt-r-fd-column rt-r-gap-3 rt-r-my-3"><div class="rt-reset rt-BaseCard rt-Card rt-r-size-2 rt-variant-surface"><div class="rt-Text rt-r-size-3 rt-r-weight-bold rt-r-mb-2">Start recognition</div><span data-accent-color="gray" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">application/json</span><span data-accent-color="gray" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">&quot;StartRecognition&quot;</span><dl data-kind="fields" class="rt-Text rt-DataListRoot rt-r-orientation-horizontal rt-r-size-2 rt-r-my-3"><div data-key="message" class="rt-DataListItem rt-r-ai-start"><dt style="--min-width:180px" class="rt-DataListLabel rt-r-min-w"><div class="rt-Box rt-r-pl-0"><div class="rt-Flex rt-r-fd-column rt-r-ai-start rt-r-gap-1"><span class="rt-Text rt-r-weight-bold"><code class="rt-reset rt-Code rt-variant-ghost">message</code></span><span data-accent-color="red" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">required</span></div></div></dt><dd class="rt-DataListValue"><div class="rt-Flex rt-r-fd-column rt-r-gap-1"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><code class="rt-reset rt-Code rt-variant-ghost">&quot;StartRecognition&quot;</code></div></div></dd></div><div data-key="transcription_config" class="rt-DataListItem rt-r-ai-start"><dt style="--min-width:180px" class="rt-DataListLabel rt-r-min-w"><div class="rt-Box rt-r-pl-0"><div class="rt-Flex rt-r-fd-column rt-r-ai-start rt-r-gap-1"><span class="rt-Text rt-r-weight-bold"><code class="rt-reset rt-Code rt-variant-ghost">transcription_config</code></span></div></div></dt><dd class="rt-DataListValue"><div class="rt-Flex rt-r-fd-column rt-r-gap-1"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><a data-accent-color="" href="#transcription-config" class="rt-Text rt-reset rt-Link rt-