exports[`snapshots > one channel 1`] = `
"<div data-is-root-theme="true" data-accent-color="indigo" data-gray-color="slate" data-has-background="true" data-panel-background="translucent" data-radius="medium" data-scaling="100%" class="radix-themes"><section data-kind="endpoint" id="v2-language" class="rt-Box rt-r-mt-7 rt-r-mb-5"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h2 class="rt-Heading rt-r-size-6"><code class="rt-reset rt-Code rt-variant-ghost">/v2/{language}</code></h2></div><div style="color:var(--gray-11)" class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><span data-accent-color="cyan" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">WSS</span> <code class="rt-reset rt-Code rt-variant-ghost">wss://eu2.rt.example.com/v2/v2/{language}</code></div></div><div data-md="">The transcription socket.</div><section data-kind="handshake" class="rt-reset rt-BaseCard rt-Card rt-r-size-1 rt-variant-surface rt-r-my-4"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3 rt-r-mb-2"><h3 class="rt-Heading rt-r-size-5">Handshake</h3></div><ul style="--width:100%;list-style:none" data-kind="handshake" class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-p-0 rt-r-pl-0 rt-r-w rt-r-my-3"><li class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><span data-accent-color="green" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">GET</span> <code class="rt-reset rt-Code rt-variant-ghost">wss://eu2.rt.example.com/v2/v2/{language}</code></li></ul><div data-md="">Production endpoint.</div><section data-kind="security" class="rt-Box rt-r-mt-4 rt-r-mb-3"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-2"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h4 class="rt-Heading rt-r-size-3">Authentication</h4></div></div><ul style="--width:100%;list-style:none" data-kind="security" class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-p-0 rt-r-pl-0 rt-r-w rt-r-my-3"><li style="border-top:1px solid var(--gray-a4)" class="rt-Box rt-r-pt-3