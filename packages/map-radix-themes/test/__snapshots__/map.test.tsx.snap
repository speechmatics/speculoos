`;

exports[`snapshots > one request/response operation 1`] = `"<div data-is-root-theme="true" data-accent-color="indigo" data-gray-color="slate" data-has-background="true" data-panel-background="translucent" data-radius="medium" data-scaling="100%" class="radix-themes"><section data-kind="operation" id="create-job" class="rt-Box rt-r-mt-7 rt-r-mb-5"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h2 class="rt-Heading rt-r-size-6">Create a job</h2></div><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><span data-accent-color="blue" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">POST</span><code class="rt-reset rt-Code rt-variant-ghost">/jobs</code></div></div><section data-kind="security" class="rt-Box rt-r-mt-5 rt-r-mb-3"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h3 class="rt-Heading rt-r-size-5">Security</h3></div></div><ul style="list-style:none" data-kind="security" class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-p-0 rt-r-my-3"><li class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><span data-accent-color="iris" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">bearer</span></li></ul></section><section data-kind="parameters" class="rt-Box rt-r-mt-5 rt-r-mb-3"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h3 class="rt-Heading rt-r-size-5">Header parameters</h3></div></div><dl data-kind="parameters" class="rt-Text rt-DataListRoot rt-r-orientation-horizontal rt-r-size-2 rt-r-my-3"><div data-key="X-Request-Id" class="rt-DataListItem rt-r-ai-start"><dt style="--min-width:180px" class="rt-DataListLabel rt-r-min-w"><div class="rt-Box rt-r-pl-0"><div class="rt-Flex rt-r-fd-column rt-r-ai-start rt-r-gap-1"><span class="rt-Text rt-r-weight-bold"><code class="rt-reset rt-Code rt-variant-ghost">X-Request-Id</code></span></div></div></dt><dd class="rt-DataListValue"><div class="rt-Flex rt-r-fd-column rt-r-gap-1"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><code class="rt-reset rt-Code rt-variant-ghost">string&lt;uuid&gt;</code></div><div data-md="">Correlation id.</div></div></dd></div></dl></section><section data-kind="request" class="rt-Box rt-r-mt-5 rt-r-mb-3"><div class="rt-Flex rt-r-fd-column rt-r-gap-2 rt-r-mb-3"><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-3"><h3 class="rt-Heading rt-r-size-5">Request body</h3></div><div class="rt-Flex rt-r-ai-center rt-r-fw-wrap rt-r-gap-2"><span data-accent-color="red" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">required</span></div></div><div dir="ltr" data-orientation="horizontal" data-kind="mediaType" class="rt-TabsRoot rt-r-my-3"><div role="tablist" aria-orientation="horizontal" style="outline:none" class="rt-BaseTabList rt-TabsList rt-r-size-2" tabindex="-1" data-orientation="horizontal"><button type="button" role="tab" aria-selected="true" aria-controls="radix-:R2hm:-content-createJob-request-application/json" data-state="active" id="radix-:R2hm:-trigger-createJob-request-application/json" class="rt-reset rt-BaseTabListTrigger rt-TabsTrigger" tabindex="-1" data-orientation="horizontal" data-radix-collection-item=""><span class="rt-BaseTabListTriggerInner rt-TabsTriggerInner"><span data-accent-color="gray" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">application/json</span></span><span class="rt-BaseTabListTriggerInnerHidden rt-TabsTriggerInnerHidden"><span data-accent-color="gray" class="rt-reset rt-Badge rt-r-size-1 rt-variant-soft">application/json</span></span></button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:R2hm:-content-createJob-request-multipart/form-data" data-state="inactive" id="radix-:R2hm:-trigger-createJob-request-multipart/form-data" class="rt-reset rt-BaseTabListTrigger rt-TabsTrigger" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="