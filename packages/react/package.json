{
  "name": "@speculoos/react",
  "version": "0.1.0-alpha.0",
  "description": "Headless React binding for the Speculoos IR. Ships no styles and no DOM.",
  "keywords": [
    "react",
    "openapi",
    "asyncapi",
    "api-reference",
    "documentation",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speechmatics/speculoos.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/speechmatics/speculoos/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/speechmatics/speculoos/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@speculoos/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@speculoos/asyncapi": "workspace:*",
    "@speculoos/fixtures": "workspace:*",
    "@speculoos/html": "workspace:*",
    "@speculoos/loader": "workspace:*",
    "@speculoos/openapi": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
