{
  "name": "@speculoos/asyncapi",
  "version": "0.0.1",
  "description": "AsyncAPI 2.x / 3.x to the Speculoos IR.",
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@speculoos/core": "workspace:*",
    "@speculoos/adapter-kit": "workspace:*",
    "@speculoos/jsonschema": "workspace:*",
    "@speculoos/loader": "workspace:*"
  },
  "devDependencies": {
    "@speculoos/fixtures": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
