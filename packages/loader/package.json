{
  "name": "@speculoos/loader",
  "version": "0.1.0-alpha.0",
  "description": "Load a project of OpenAPI/AsyncAPI documents and resolve $refs across them.",
  "keywords": [
    "openapi",
    "asyncapi",
    "json-schema",
    "$ref"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speechmatics/speculoos.git",
    "directory": "packages/loader"
  },
  "homepage": "https://github.com/speechmatics/speculoos/tree/main/packages/loader#readme",
  "bugs": {
    "url": "https://github.com/speechmatics/speculoos/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@speculoos/core": "workspace:*",
    "@speculoos/jsonschema": "workspace:*",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
