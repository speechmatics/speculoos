{
  "name": "@speculoos/core",
  "version": "0.0.1",
  "description": "The Speculoos intermediate representation: types and pure operations.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.mjs",
      "require": "./dist/validate.js"
    },
    "./schema.json": "./schema/apiir.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm schema && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "schema": "node scripts/gen-schema.mjs",
    "schema:check": "node scripts/gen-schema.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "peerDependencies": {
    "ajv": "^8.17.1"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  }
}
