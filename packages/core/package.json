{
  "name": "@speculoos/core",
  "version": "0.1.0-alpha.0",
  "description": "The Speculoos intermediate representation: types and pure operations.",
  "keywords": [
    "openapi",
    "asyncapi",
    "api-reference",
    "intermediate-representation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speechmatics/speculoos.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/speechmatics/speculoos/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/speechmatics/speculoos/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate.d.mts",
        "default": "./dist/validate.mjs"
      },
      "require": {
        "types": "./dist/validate.d.ts",
        "default": "./dist/validate.js"
      }
    },
    "./schema.json": "./schema/apiir.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "pnpm schema && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "schema": "node scripts/gen-schema.mjs",
    "schema:check": "node scripts/gen-schema.mjs --check"
  },
  "peerDependencies": {
    "ajv": "^8.17.1"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
