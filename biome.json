{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/test/**",
      "packages/*/scripts/**",
      "packages/*/*.config.ts",
      "scripts/**",
      "preview/**",
      "!preview/out",
      "!preview/**/*.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off"
      }
    }
  }
}
