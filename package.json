{
  "name": "speculoos",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Render OpenAPI and AsyncAPI specs in your own design system, via a shared intermediate representation.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "speculoos": "node packages/cli/dist/cli.js",
    "preview": "node preview/build.mjs",
    "preview:serve": "node preview/build.mjs --serve",
    "preview:radix": "pnpm --filter @speculoos/map-radix-themes dev",
    "pack:local": "node scripts/pack-local.mjs",
    "docs:diagnostics": "node scripts/diagnostics-doc.mjs",
    "docs:check": "node scripts/diagnostics-doc.mjs --check"
  },
  "devDependencies": {
    "@speculoos/asyncapi": "workspace:*",
    "@speculoos/core": "workspace:*",
    "@speculoos/fixtures": "workspace:*",
    "@speculoos/html": "workspace:*",
    "@speculoos/loader": "workspace:*",
    "@speculoos/openapi": "workspace:*",
    "markdown-it": "^14.1.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speechmatics/speculoos.git"
  }
}
